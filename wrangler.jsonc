// Cloudflare Workers deploy for try.archimaid.org. Build first (`npm ci && npm run build`),
// then `npx wrangler deploy` uploads dist. The name must match the Worker connected in Cloudflare.
{
  "name": "archimaid-playground",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
